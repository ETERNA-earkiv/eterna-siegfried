#!/bin/bash
set -e

SIEGFRIED_HOST="${SIEGFRIED_HOST:-0.0.0.0}"
SIEGFRIED_PORT="${SIEGFRIED_PORT:-5138}"
SF_HOME="${XDG_DATA_HOME:-${HOME:-/home/nonroot}/.local/share}/siegfried"

mkdir -p "$SF_HOME"

if [ ! -f "$SF_HOME/default.sig" ]; then
    echo "[siegfried] Laddar ned signaturer..."
    sf -update
fi

exec sf -serve "${SIEGFRIED_HOST}:${SIEGFRIED_PORT}"
